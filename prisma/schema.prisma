generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum QuoteStatus {
  RECEIVED
  UNDER_REVIEW
  NEEDS_INFORMATION
  PROPOSAL_SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @db.VarChar(24)
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  quoteRequests QuoteRequest[]
  orders        Order[]
  statusHistory StatusHistory[] @relation("StatusHistoryActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String?  @db.VarChar(24)
  postalCode    String   @db.VarChar(16)
  street        String
  number        String   @db.VarChar(32)
  complement    String?
  neighborhood  String
  city          String
  state         String   @db.VarChar(100)
  country       String   @default("BR") @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products      Product[]
  quoteRequests QuoteRequest[]
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  sku         String?  @unique
  name        String
  slug        String   @unique
  description String   @db.Text
  basePrice   Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.Text
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model QuoteRequest {
  id            String      @id @default(cuid())
  userId        String?
  categoryId    String?
  customerName  String
  customerEmail String      @db.VarChar(254)
  customerPhone String      @db.VarChar(24)
  partName      String
  application   String?
  description   String      @db.Text
  quantity      Int         @default(1)
  status        QuoteStatus @default(RECEIVED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments   QuoteAttachment[]
  proposals     Proposal[]
  orders        Order[]
  statusHistory StatusHistory[]

  @@index([userId, createdAt])
  @@index([categoryId])
  @@index([status, createdAt])
}

model QuoteAttachment {
  id             String   @id @default(cuid())
  quoteRequestId String
  storageKey     String   @unique
  fileName       String
  contentType    String   @db.VarChar(127)
  sizeBytes      BigInt
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model Proposal {
  id             String         @id @default(cuid())
  quoteRequestId String
  version        Int            @default(1)
  status         ProposalStatus @default(DRAFT)
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("BRL") @db.Char(3)
  scope          String         @db.Text
  deliveryDays   Int?
  expiresAt      DateTime?
  sentAt         DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  order        Order?

  @@unique([quoteRequestId, version])
  @@index([status, expiresAt])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  quoteRequestId String?
  proposalId     String?     @unique
  addressId      String?
  status         OrderStatus @default(DRAFT)
  currency       String      @default("BRL") @db.Char(3)
  subtotal       Decimal     @db.Decimal(12, 2)
  shippingAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteRequest  QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  proposal      Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  address       Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory StatusHistory[]

  @@index([userId, createdAt])
  @@index([quoteRequestId])
  @@index([addressId])
  @@index([status, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  name        String
  description String?  @db.Text
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BRL") @db.Char(3)
  provider          String?
  providerReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@unique([provider, providerReference])
}

model StatusHistory {
  id             String   @id @default(cuid())
  quoteRequestId String?
  orderId        String?
  actorUserId    String?
  fromStatus     String?
  toStatus       String
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor        User?         @relation("StatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // A database check in the initial migration requires exactly one status subject.
  @@index([quoteRequestId, createdAt])
  @@index([orderId, createdAt])
  @@index([actorUserId])
}
