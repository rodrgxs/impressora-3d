# Apenas digitos, com codigo do pais e DDD. Ex.: 5511999999999
# Deixe vazio ate configurar o numero comercial real.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL definitiva do site, apos contratar e configurar o dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL privada do PostgreSQL. Substitua os valores de exemplo no ambiente local/de deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peca_lab?schema=public"

# Conexao direta privada para migrations (nao use NEXT_PUBLIC_).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/peca_lab?schema=public"
# Auth.js: configure um segredo aleatorio de pelo menos 32 caracteres apenas no ambiente.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Opcional: header sobrescrito pelo proxy confiavel. Vazio usa um limite global conservador.
AUTH_CLIENT_IP_HEADER=
# Habilite apenas quando o proxy/host da aplicacao for confiavel.
AUTH_TRUST_HOST=
